        Draw text "SCORE: " joined with score at position 10, 10.
    If game_over is 1:
        Draw text "GAME OVER" at position 300, 250.
        Draw text "Score: " joined with score at position 300, 300.
        Draw text "Press R to Restart" at position 300, 350.
        If r key is pressed:
            Set game_over to 0.
            Set score to 0.
            Set snake_len to 1.
            Set s1_x to 10.
            Set s1_y to 10.
            Set dir_x to 1.
            Set dir_y to 0.
            Set next_dir_x to 1.
            Set next_dir_y to 0.
            Set food_x to a random number between 1 and 38.
            Set food_y to a random number between 1 and 28.
            Set food_real_x to (food_x * 20).
            Set food_real_y to (food_y * 20).
    End drawing.
